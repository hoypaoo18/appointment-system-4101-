# Copy these values into .env.production or Hostinger Environment Variables.
# Fill ALL required values before deployment. hPanel variables override this file.
NODE_ENV=production
APP_ENV=production
PUBLIC_ORIGIN=https://your-domain.example
# Use the database host shown in hPanel; localhost is common for Hostinger MySQL.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_hostinger_database_name
DB_USER=your_hostinger_database_user
# Quote passwords so spaces and # characters are preserved. Do not share this file after filling it.
DB_PASSWORD=""
HOST=0.0.0.0
PORT=3000

# Optional email delivery. Leave blank until an SMTP account is configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=""
SMTP_FROM=
REMINDER_MINUTES=60

# First deployment: real administrator account, minimum 12-character password.
ADMIN_NAME=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
# Optional: create an assistant account for booking/editing appointments.
ASSISTANT_NAME=""
ASSISTANT_EMAIL=""
ASSISTANT_PASSWORD=""
# After successful setup, clear bootstrap passwords here and in hPanel.
# Subsequent deployments preserve existing accounts and passwords.
